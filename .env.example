PORT=3000 # порт застосунку

DB_HOST=localhost # хост БД
DB_PORT=5432 # порт БД
DB_USER=root # користувач БД
DB_NAME=marketplace # назва БД
DB_PASSWORD_FILE=secrets/db_password # файл до пароля БД

DB_URL=postgres://root:changeme@localhost:5432/marketplace # повний рядок підключення (опціональна альтернатива DB_HOST/DB_PORT/DB_USER/DB_NAME; пароль фейковий)